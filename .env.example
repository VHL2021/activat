# Copia este archivo como .env.local y rellena los valores. Nunca subas .env.local al repositorio.
DATABASE_URL=postgres://usuario:contraseña@localhost:5432/gym
# Clave de al menos 32 caracteres para cifrar la sesión. Genera una con: openssl rand -base64 32
SESSION_PASSWORD=
# Dirección pública de la web, para los enlaces de los emails. Ej.: https://reservas.tugimnasio.es
APP_URL=http://localhost:3000
# Envío de emails con Brevo (https://www.brevo.com). Sin clave, los emails se muestran en la consola.
BREVO_API_KEY=
EMAIL_FROM=reservas@tugimnasio.es
EMAIL_FROM_NAME=Reservas del gimnasio
